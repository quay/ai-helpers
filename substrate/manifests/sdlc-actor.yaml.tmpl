apiVersion: v1
kind: Namespace
metadata:
  name: ate-sdlc

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: sdlc
  namespace: ate-sdlc
spec:
  replicas: 3
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: sdlc
  namespace: ate-sdlc
spec:
  runsc:
    amd64:
      url: "gs://gvisor/releases/nightly/2026-05-19/x86_64/runsc"
      sha256Hash: "a397be1abc2420d26bce6c70e6e2ff96c73aaaab929756c56f5e2089ea842b63"
    arm64:
      url: "gs://gvisor/releases/nightly/2026-05-19/aarch64/runsc"
      sha256Hash: "1ba2366ae2efceba166046f51a4104f9261c9cb72c6db8f5b3fe2dc57dea86b9"
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: sdlc
    image: ${SDLC_ACTOR_IMAGE}
    command: ["/sdlc-actor"]
    env:
    - name: GITHUB_REPO
      value: "${GITHUB_REPO}"
    - name: GITHUB_TOKEN
      valueFrom:
        secretKeyRef:
          name: sdlc-actor-secrets
          key: github-token
          optional: true
    - name: ATE_API_ADDR
      value: "api.ate-system.svc:443"
    - name: JIRA_BASE_URL
      value: "${JIRA_BASE_URL}"
    - name: JIRA_USER
      valueFrom:
        secretKeyRef:
          name: sdlc-actor-secrets
          key: jira-user
          optional: true
    - name: JIRA_API_TOKEN
      valueFrom:
        secretKeyRef:
          name: sdlc-actor-secrets
          key: jira-api-token
          optional: true
    - name: ANTHROPIC_API_KEY
      valueFrom:
        secretKeyRef:
          name: sdlc-actor-secrets
          key: anthropic-api-key
          optional: true
    - name: HOME
      value: "/tmp/home"
    - name: PATH
      value: "/home/actor/.local/bin:/home/actor/.claude/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    - name: CLAUDE_CODE_USE_VERTEX
      value: "${CLAUDE_CODE_USE_VERTEX}"
    - name: ANTHROPIC_VERTEX_PROJECT_ID
      value: "${ANTHROPIC_VERTEX_PROJECT_ID}"
    - name: CLOUD_ML_REGION
      value: "${CLOUD_ML_REGION}"
    - name: GCP_SA_KEY_B64
      value: "${GCP_SA_KEY_B64}"
  workerPoolRef:
    namespace: ate-sdlc
    name: sdlc
  snapshotsConfig:
    location: gs://${BUCKET_NAME}/ate-sdlc/
